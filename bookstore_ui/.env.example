# BookStore Environment Variables
SECRET_KEY=django-insecure-replace-with-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Google Books API Key (Optional: rate limits are higher when provided)
GOOGLE_BOOKS_API_KEY=

# Google Gemini AI API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT=15
